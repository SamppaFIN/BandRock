{
  "name": "bandrock",
  "private": true,
  "type": "module",
  "description": "BandRock: ilmoitustaulu bändeille (GitHub Pages, staattinen). Worker + R2 -tallennus tulossa vaiheessa 2.",
  "scripts": {
    "test": "node --test",
    "dev:worker": "wrangler dev",
    "deploy:worker": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "devDependencies": {
    "wrangler": "^4.136.1"
  }
}
